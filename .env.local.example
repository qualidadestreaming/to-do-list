# Copie este arquivo para .env.local e preencha com os valores do seu projeto Supabase
# (Project Settings → API).

NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Project Settings → API → JWT Settings → JWT Secret (legacy).
# Usado só no servidor para assinar o token de sessão do departamento — nunca
# exponha isso no cliente.
SUPABASE_JWT_SECRET=

# Project Settings → API → service_role key.
# Usado só no servidor (Server Actions/API routes) para operações
# administrativas que precisam bypassar RLS (ex: criar departamento).
SUPABASE_SERVICE_ROLE_KEY=
